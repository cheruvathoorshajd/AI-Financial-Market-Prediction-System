# Environment variables
.env
.env.local
.env.production

# Secrets / SSH keys — NEVER commit these
*.pem
*.key
*_rsa
*_ed25519

# Local scratch (screenshots, etc.)
image.png

# Per-box opt-in marker to install ML extras (torch) — see deploy/deploy.sh
backend/.enable-ml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
# NOTE: lib/ and lib64/ are anchored to the repo root so they only ignore
# Python build artifacts there — an un-anchored "lib/" also matches
# frontend/src/lib/, which silently left the entire frontend lib dir untracked.
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database
*.db
*.sqlite
*.sqlite3

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React Build
frontend/build/
frontend/.env.local
frontend/.env.production

