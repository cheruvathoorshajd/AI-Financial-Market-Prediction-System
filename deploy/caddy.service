[Unit]
Description=Caddy
After=network.target

[Service]
# Runs as ec2-user so Caddy can read frontend/build in the user's home,
# with CAP_NET_BIND_SERVICE so a non-root user can still bind ports 80/443.
User=ec2-user
Group=ec2-user
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/Caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --force
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
